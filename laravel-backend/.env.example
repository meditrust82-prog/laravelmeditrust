APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:5003
APP_TIMEZONE=UTC

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medi_db
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change_this_jwt_secret

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

KHALTI_SECRET_KEY=your_khalti_secret
KHALTI_ALLOWED_IPS=203.0.113.1,203.0.113.2

GBP_CLIENT_ID=your_google_client_id
GBP_CLIENT_SECRET=your_google_client_secret
GBP_REDIRECT_URI=http://localhost:8000/api/v1/gbp/callback
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACE_ID=your_google_place_id

GROQ_API_KEY=your_groq_api_key
# xAI Grok (used by the AI Blog Writer; falls back to Groq if unset)
XAI_API_KEY=your_xai_api_key
GROK_MODEL=grok-2-latest
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

SESSION_DRIVER=cookie
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5003,127.0.0.1:8001
